{
  "name": "freela-agent",
  "version": "0.1.0",
  "description": "Local agent for ranking freelance opportunities against a technical profile.",
  "type": "module",
  "bin": {
    "freela-agent": "./dist/main.js"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\"",
    "db:reset": "tsx src/storage/resetDatabase.ts",
    "clean": "trash dist output/recommendations.md output/recommendations.json 2>/dev/null || true"
  },
  "keywords": [
    "freelance",
    "upwork",
    "agent",
    "ranking"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
